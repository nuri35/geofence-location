# Application
# Runtime environment: development | test | production (optional, default: development)
NODE_ENV=development
# HTTP port the API listens on (optional, default: 3000)
PORT=3000
# Presence read strategy under measurement (ADR 0007): two-step | folded | cache
# (optional, default: two-step; scaffolding — removed once the decision is closed)
PRESENCE_READ_STRATEGY=two-step

# PostgreSQL (PostGIS) — all POSTGRES_* variables are REQUIRED; startup aborts if any is missing
# Hostname of the Postgres server (docker compose service is exposed on localhost)
POSTGRES_HOST=localhost
# Host port mapped to the container's 5432 (also read by docker-compose.yml).
# Pick a free port (e.g. 5433) if a native PostgreSQL already listens on 5432.
POSTGRES_PORT=5432
# Database superuser created by the container on first boot
POSTGRES_USER=geofence
# Password for POSTGRES_USER
POSTGRES_PASSWORD=geofence
# Database name created by the container on first boot
POSTGRES_DB=geofence

# Redis — REDIS_HOST and REDIS_PORT are REQUIRED
# Hostname of the Redis server (docker compose service is exposed on localhost)
REDIS_HOST=localhost
# Host port mapped to the container's 6379 (also read by docker-compose.yml)
REDIS_PORT=6379
# Redis password (optional); leave empty for the local docker instance (no auth)
REDIS_PASSWORD=
